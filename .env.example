# Supabase (AI DM chat endpoint + auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PartyKit (multiplayer WebSocket server)
# Defaults to 127.0.0.1:1999 when unset (local dev).
# Set this to your deployed PartyKit host for production, e.g.:
#   VITE_PARTYKIT_HOST=phantom-bard.your-username.partykit.dev
VITE_PARTYKIT_HOST=
